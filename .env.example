# Supabase — ★ speciai-kakao-bot / linktalk 과 **다른** 프로젝트를 쓸 것.
# 그 DB 는 이미 앱 둘이 소속 판정을 공유하고 있다. 세 번째를 얹지 말 것.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 봇 ↔ 서버 공유 비밀. bot/gccity-bot.js 의 TOKEN 과 같은 값.
GCCITY_INGEST_TOKEN=

# 대시보드 비밀번호. 단일 사용자용 한 겹이다.
GCCITY_PASSWORD=

# 방 찾기 모드를 한 번 켰을 때 유지되는 시간(분). 기본 30.
# 이 시간이 지나면 서버가 자동으로 끈다 — 켜둔 걸 잊으면 개인 카톡 미리보기가 계속 올라온다.
GCCITY_DISCOVERY_MINUTES=30
