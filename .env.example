# Supabase — ★ speciai-kakao-bot / linktalk 과 **다른** 프로젝트를 쓸 것.
# 그 DB 는 이미 앱 둘이 소속 판정을 공유하고 있다. 세 번째를 얹지 말 것.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 봇 ↔ 서버 공유 비밀. bot/gccity-bot.js 의 TOKEN 과 같은 값.
GCCITY_INGEST_TOKEN=

# 대시보드 비밀번호. 단일 사용자용 한 겹이다.
GCCITY_PASSWORD=

# 방 찾기 모드를 한 번 켰을 때 유지되는 시간(분). 기본 30.
# 이 시간이 지나면 서버가 자동으로 끈다 — 켜둔 걸 잊으면 개인 카톡 미리보기가 계속 올라온다.
GCCITY_DISCOVERY_MINUTES=30

# 모델 — 카톡 요약·카페 글 요약·짝 제안이 쓴다. 없으면 그 셋만 실패하고 수집·목록은 계속 돈다.
ANTHROPIC_API_KEY=

# 모델 이름. 비우면 claude-opus-5.
GCCITY_DIGEST_MODEL=

# 카톡 분석이 밀렸다고 화면이 알리는 기준(시간). 기본 24.
GCCITY_DIGEST_HOURS=

# 크론 인증. ★ /api/cron/* 는 미들웨어를 통과하므로 라우트가 이 값을 직접 검사한다.
#   비우면 크론 라우트가 401 로 닫힌다(fail-closed) — 자동 수집이 조용히 멈추지 않게.
CRON_SECRET=

# 회신문에서 부서를 뽑을 때 쓰는 기관 이름. 쉼표로 여럿 (예: 과천시청,과천시).
# 비우면 한국 지자체 일반형(○○시청·○○군청·○○구청…)으로 돈다.
# ★ 정규식이 아니라 이름 목록이다. 값은 그대로 이스케이프해 쓴다.
CIVIC_OFFICE_NAMES=
